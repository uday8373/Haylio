# Optional: enables real AI chat in the widget. Without it, the widget
# falls back to FAQ keyword matching.
ANTHROPIC_API_KEY=

# Supabase persistence. Without these, data lives in memory (resets on restart).
# Run supabase/schema.sql in the Supabase SQL editor before first use.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Places API key — powers "find your business on Google" at signup.
# Enable "Places API (New)" in Google Cloud Console. Without it, signup
# falls back to manual business entry only.
GOOGLE_PLACES_API_KEY=

# Twilio (Privacy Wrapper: toll-free numbers, call intercept, SMS).
# Leave empty for simulator mode — the full pipeline runs with fake numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public HTTPS base URL for webhooks + tracked SMS links.
PUBLIC_BASE_URL=http://localhost:3000
